{
  "name": "signalos-elite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "test:amsa": "vitest run src/lib/amsa",
    "test:smoke": "tsx --test tests/smoke/**/*.test.ts",
    "test:pullback": "vitest run src/lib/pullback src/app/api/pullback-watch/route.test.ts",
    "test:pullback:mobile": "playwright test --config tests/pullback/playwright.config.ts",
    "pullback:monitor": "tsx --env-file .env.local scripts/pullbackWatch.ts",
    "pullback:dev": "tsx scripts/pullbackDev.ts app",
    "pullback:dev:check": "tsx scripts/pullbackDev.ts check",
    "pullback:dev:monitor": "tsx scripts/pullbackDev.ts monitor",
    "ingest": "tsx --env-file .env.local scripts/ingest/index.ts",
    "signals": "tsx --env-file .env.local scripts/signals/buildConviction.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.1.6",
    "openai": "^6.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.3",
    "stripe": "^22.0.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
